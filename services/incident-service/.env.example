# Incident Service Environment Variables

# Server
PORT=3003
NODE_ENV=development
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openrisksos

# Cache
REDIS_URL=redis://localhost:6379

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3003

# JWT
JWT_SECRET=your-jwt-secret-key-change-in-production

# Kafka (for event streaming)
KAFKA_BROKERS=kafka:29092
KAFKA_CLIENT_ID=incident-service

# Feature Flags
ENABLE_TIMELINE_TRACKING=true
ENABLE_CORRECTIVE_ACTIONS=true
ENABLE_INCIDENT_ANALYTICS=true
ENABLE_NOTIFICATIONS=true
