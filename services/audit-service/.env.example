# Audit Service Environment Variables

# Server
PORT=3004
NODE_ENV=development
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openrisksos

# Cache
REDIS_URL=redis://localhost:6379

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3004

# JWT
JWT_SECRET=your-jwt-secret-key-change-in-production

# Feature Flags
ENABLE_FINDING_TRACKING=true
ENABLE_EVIDENCE_COLLECTION=true
ENABLE_AUDIT_ANALYTICS=true
ENABLE_REMEDIATION_TRACKING=true
