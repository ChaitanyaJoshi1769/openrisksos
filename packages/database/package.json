{
  "name": "@openrisksos/database",
  "version": "0.1.0",
  "description": "Prisma database schema and migrations",
  "private": true,
  "scripts": {
    "db:migrate": "prisma migrate deploy",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:seed": "node --require ts-node/register scripts/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.7.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "prisma": "^5.7.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3"
  }
}
